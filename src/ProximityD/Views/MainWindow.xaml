<Window x:Class="ProximityD.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="ProximityD - Bluetooth Proximity Detection"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ProximityD" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Bluetooth Proximity Detection for Windows" Foreground="#7F8C8D"/>
        </StackPanel>

        <!-- Status Panel -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Proximity" FontWeight="SemiBold" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock Text="{Binding ProximityStateText}" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Signal (Smoothed)" FontWeight="SemiBold" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock FontSize="14" Margin="0,3,0,0">
                        <Run Text="{Binding SmoothedRssi, StringFormat='{}{0:F1}'}"/>
                        <Run Text=" dBm"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Distance" FontWeight="SemiBold" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock FontSize="14" Margin="0,3,0,0">
                        <Run Text="{Binding DistanceMeters, StringFormat='{}{0:F1}'}"/>
                        <Run Text=" m"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Tabs -->
        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <!-- Devices Tab -->
            <TabItem Header="Devices">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Discover Devices" Command="{Binding DiscoverDevicesCommand}" Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Calibrate" Click="Calibrate_Click" Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Save" Command="{Binding SaveSettingsCommand}" Padding="10,5"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding TrackedDevices}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Enabled" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding DeviceName}"/>
                                <GridViewColumn Header="ID" Width="200" DisplayMemberBinding="{Binding DeviceId}"/>
                                <GridViewColumn Header="State" Width="100" DisplayMemberBinding="{Binding LastState}"/>
                                <GridViewColumn Header="RSSI" Width="80" DisplayMemberBinding="{Binding LastRssi}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="Lock/Unlock Behavior" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <CheckBox Content="Enable Auto-Lock (lock when device leaves range)" IsChecked="{Binding AutoLockEnabled}" Margin="0,3"/>
                                <CheckBox Content="Enable Auto-Unlock (signal presence when device returns)" IsChecked="{Binding AutoUnlockEnabled}" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Signal Thresholds" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Lock threshold (dBm)" VerticalAlignment="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="-40" Value="{Binding LockThreshold}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LockThreshold}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Unlock threshold (dBm)" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="-40" Value="{Binding UnlockThreshold}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding UnlockThreshold}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lock delay (seconds)" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="60" Value="{Binding LockDelay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LockDelay}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Unlock delay (seconds)" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding UnlockDelay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding UnlockDelay}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Padding="15,8" Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Signal Graph Tab -->
            <TabItem Header="Signal Graph">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Clear" Command="{Binding SignalGraph.ClearCommand}" Padding="10,5"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Row="1" Model="{Binding SignalGraph.PlotModel}"/>
                </Grid>
            </TabItem>

            <!-- Log Tab -->
            <TabItem Header="Event Log">
                <ListBox ItemsSource="{Binding EventLog}" Margin="10" FontFamily="Consolas" FontSize="11"/>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="5">
            <TextBlock Text="ProximityD v1.0 • Minimize to system tray" Foreground="#ADB5BD" FontSize="11"/>
        </Border>
    </Grid>
</Window>
